{
  "name": "Bible Markdown",
  "short_name": "BibleMD",
  "description": "Edit Bible translations in Bible Markdown, USFM and Bible HTML",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fbfbfa",
  "theme_color": "#2b4c7e",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "text/markdown": [".md"], "text/html": [".html"], "text/plain": [".usfm", ".sfm"] } }
  ]
}
